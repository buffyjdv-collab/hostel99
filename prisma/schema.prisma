generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ───────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  password      String
  role          String   @default("manager") // super_admin, owner, manager, staff, tenant
  avatar        String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedProperties     Property[]      @relation("PropertyOwner")
  staffProfile        Staff?
  tenantProfile       Tenant?
  ledActivities       ActivityLog[]
  createdLeads        Lead[]              @relation("LeadCreator")
  assignedLeads       Lead[]              @relation("LeadAssignee")
  complaints          Complaint[]         @relation("ComplaintCreator")
  assignedComplaints  Complaint[]         @relation("ComplaintAssignee")
  expenses            Expense[]           @relation("ExpenseCreator")
  notices             Notice[]            @relation("NoticeCreator")
  sentMessages        Communication[]     @relation("MessageSender")
  visitors            Visitor[]           @relation("VisitorHost")
  attendance          Attendance[]
  prRequested         PurchaseRequisition[] @relation("PRRequestor")
  prApproved          PurchaseRequisition[] @relation("PRApprover")
  poCreated           PurchaseOrder[] @relation("POCreator")
  poApproved          PurchaseOrder[] @relation("POApprover")
  grnReceived         GoodsReceivedNote[] @relation("GRNReceiver")
  stockTransactions   StockTransaction[] @relation("StockTransactionUser")
  kitchenIssued       KitchenIssue[] @relation("KitchenIssuer")
  attendanceMarked    MessAttendance[] @relation("AttendanceMarker")
  wasteRecorded       WasteRecord[] @relation("WasteRecorder")

  // Hostel assignments (multi-tenancy)
  hostelAssignments   HostelAssignment[]

  // Per-user permission overrides (micro RBAC)
  permissionOverrides UserPermissionOverride[]
}

// ─── Property Management ───────────────────────────────────
model Property {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("pg") // pg, hostel, co_living, apartment
  address     String
  city        String
  state       String?
  pincode     String?
  landmark    String?
  description String?
  contactPhone String?
  contactEmail String?
  totalRooms  Int      @default(0)
  totalBeds   Int      @default(0)
  occupancy   Int      @default(0)
  amenities   String?
  images      String?
  isActive    Boolean  @default(true)
  ownerId     String
  owner       User     @relation("PropertyOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildings         Building[]
  floors            Floor[]
  rooms             Room[]
  leads             Lead[]
  tenants           Tenant[]
  expenses          Expense[]
  staff             Staff[]
  notices           Notice[]
  visitors          Visitor[]
  inventoryCategories InventoryCategory[]
  inventoryItems    InventoryItem[]
  vendors           Vendor[]
  vendorQuotations  VendorQuotation[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders    PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  stockTransactions StockTransaction[]
  menuPlans         MenuPlan[]
  recipes           Recipe[]
  kitchenIssues     KitchenIssue[]
  messAttendance    MessAttendance[]
  consumptionLogs   ConsumptionLog[]
  wasteRecords      WasteRecord[]
  assets            Asset[]
  laundryItems      LaundryItem[]
  housekeepingItems HousekeepingItem[]

  // Hostel assignments (multi-tenancy)
  hostelAssignments HostelAssignment[]
}

model Building {
  id          String   @id @default(cuid())
  name        String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  wings       String?
  totalFloors Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floors Floor[]
  rooms  Room[]
}

model Floor {
  id         String   @id @default(cuid())
  name       String
  number     Int
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  wing       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rooms Room[]
}

model Room {
  id           String   @id @default(cuid())
  name         String
  number       String
  floorId      String
  floor        Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sharingType  String   @default("single") // single, double, triple, four_sharing
  roomType     String   @default("non_ac") // ac, non_ac, deluxe, premium
  totalBeds    Int      @default(1)
  occupiedBeds Int      @default(0)
  rent         Float    @default(0)
  deposit      Float    @default(0)
  amenities    String?
  status       String   @default("available") // available, occupied, maintenance, blocked
  images       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  beds      Bed[]
  tenants   Tenant[]
  bookings  Booking[]
  assets    Asset[]
  laundryItems LaundryItem[]
}

model Bed {
  id         String   @id @default(cuid())
  name       String
  number     Int
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status     String   @default("available") // available, occupied, blocked, maintenance
  tenantId   String?  @unique
  tenant     Tenant?  @relation("BedTenant")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Lead CRM ──────────────────────────────────────────────
model Lead {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String
  source         String   @default("website") // website, whatsapp, referral, walk_in, google, social_media
  status         String   @default("lead") // lead, inquiry, site_visit, negotiation, token, booking, move_in, lost
  stage          Int      @default(1)
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  roomPreference String?
  budget         Float?
  visitDate      DateTime?
  visitNotes     String?
  followUpDate   DateTime?
  followUpNotes  String?
  tokenAmount    Float?
  notes          String?
  lostReason     String?
  assignedToId   String?
  assignedTo     User?    @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User     @relation("LeadCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]
}

// ─── Tenant Management ─────────────────────────────────────
model Tenant {
  id               String   @id @default(cuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id])
  name             String
  email            String?
  phone            String
  emergencyContact String?
  emergencyPhone   String?
  fatherName       String?
  motherName       String?
  aadhaarNumber    String?
  panNumber        String?
  passportNumber   String?
  dateOfBirth      DateTime?
  gender           String?
  occupation       String?
  company          String?
  permanentAddress String?
  kycStatus        String   @default("pending") // pending, verified, rejected
  policeVerified   Boolean  @default(false)
  agreementStatus  String   @default("pending") // pending, signed, expired
  agreementStart   DateTime?
  agreementEnd     DateTime?
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])
  roomId           String?
  room             Room?    @relation(fields: [roomId], references: [id])
  bedId            String?  @unique
  bed              Bed?     @relation("BedTenant", fields: [bedId], references: [id])
  checkInDate      DateTime?
  checkOutDate     DateTime?
  status           String   @default("active") // active, inactive, notice_period, moved_out
  rentAmount       Float    @default(0)
  depositAmount    Float    @default(0)
  depositStatus    String   @default("pending") // pending, paid, refunded, partially_refunded
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments     Payment[]
  complaints   Complaint[]
  visitors     Visitor[]
  documents    Document[]
  bookings     Booking[]
  messAttendance MessAttendance[]
}

// ─── Booking & Check-in ────────────────────────────────────
model Booking {
  id           String   @id @default(cuid())
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id])
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  propertyId   String
  checkInDate  DateTime
  checkOutDate DateTime?
  status       String   @default("confirmed") // confirmed, checked_in, checked_out, cancelled
  bookingType  String   @default("new") // new, renewal, transfer
  tokenAmount  Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Rent & Payment ────────────────────────────────────────
model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  propertyId     String
  amount         Float
  rentAmount     Float    @default(0)
  electricity    Float    @default(0)
  water          Float    @default(0)
  wifi           Float    @default(0)
  food           Float    @default(0)
  laundry        Float    @default(0)
  parking        Float    @default(0)
  otherCharges   Float    @default(0)
  lateFine       Float    @default(0)
  discount       Float    @default(0)
  advanceAdjust  Float    @default(0)
  paymentMethod  String   @default("upi") // upi, bank_transfer, card, wallet, cash, qr
  paymentType    String   @default("rent") // rent, deposit, token, other
  status         String   @default("pending") // pending, paid, failed, overdue
  dueDate        DateTime
  paidDate       DateTime?
  receiptNumber  String?
  utrNumber      String?
  notes          String?
  month          Int
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Complaint Management ──────────────────────────────────
model Complaint {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String   @default("maintenance") // maintenance, cleanliness, noise, food, staff, other
  priority     String   @default("medium") // low, medium, high, urgent
  status       String   @default("open") // open, assigned, in_progress, resolved, closed
  rating       Int?
  resolution   String?
  propertyId   String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User     @relation("ComplaintCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities ActivityLog[]
}

// ─── Staff Management ──────────────────────────────────────
model Staff {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  phone         String
  role          String   @default("caretaker") // caretaker, housekeeping, maintenance, security, cook, manager
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  salary        Float    @default(0)
  joinDate      DateTime?
  status        String   @default("active") // active, inactive, on_leave
  aadhaarNumber String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendance     Attendance[]
  salaryPayments SalaryPayment[]
}

model Attendance {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("present") // present, absent, half_day, leave
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryPayment {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount    Float
  month     Int
  year      Int
  status    String   @default("paid") // paid, pending, processing
  paidDate  DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Accounting ────────────────────────────────────────────
model Expense {
  id          String   @id @default(cuid())
  category    String   @default("maintenance") // maintenance, utilities, salary, supplies, food, marketing, other
  description String
  amount      Float
  date        DateTime
  vendor      String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdById String
  createdBy   User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  receipt     String?
  status      String   @default("approved") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Communication ─────────────────────────────────────────
model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("general") // general, urgent, maintenance, event, payment
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdById String
  createdBy   User     @relation("NoticeCreator", fields: [createdById], references: [id])
  isActive    Boolean  @default(true)
  expiryDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Communication {
  id            String   @id @default(cuid())
  type          String   @default("whatsapp") // whatsapp, sms, email, push, announcement
  message       String
  recipientType String   @default("all") // all, tenants, staff, specific
  recipientId   String?
  propertyId    String?
  senderId      String
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])
  status        String   @default("sent") // sent, delivered, failed, read
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Visitor Management ────────────────────────────────────
model Visitor {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  purpose    String
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  hostId     String?
  host       User?    @relation("VisitorHost", fields: [hostId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  checkIn    DateTime
  checkOut   DateTime?
  status     String   @default("checked_in") // checked_in, checked_out
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Documents ─────────────────────────────────────────────
model Document {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("identity") // identity, agreement, receipt, photo, other
  fileUrl    String
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  propertyId String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Activity Log ──────────────────────────────────────────
model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  details     String?
  entityType  String
  entityId    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id])
  createdAt   DateTime @default(now())
}

// ─── Subscription ──────────────────────────────────────────
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   @default("basic") // basic, premium, gold, white_label
  status    String   @default("active") // active, expired, cancelled, trial
  startDate DateTime
  endDate   DateTime?
  amount    Float    @default(0)
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Inventory Management ──────────────────────────────────
model InventoryCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InventoryItem[]
}

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  sku          String?
  categoryId   String
  category     InventoryCategory @relation(fields: [categoryId], references: [id])
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  unit         String   @default("kg") // kg, l, pcs, pack, box, bottle, can, cylinder
  unitPrice    Float    @default(0)
  currentStock Float    @default(0)
  openingStock Float    @default(0)
  minStock     Float    @default(0)   // low-stock alert threshold
  maxStock     Float?
  reorderLevel Float?
  batchNumber  String?
  expiryDate   DateTime?
  storeLocation String?
  gstRate      Float    @default(0)
  hsnCode      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  kitchenIssues     KitchenIssue[]
  recipeItems       RecipeItem[]
  consumptionLogs   ConsumptionLog[]
  wasteRecords      WasteRecord[]
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  panNumber     String?
  bankName      String?
  bankAccount   String?
  ifscCode      String?
  paymentTerms  String?
  rating        Int      @default(0) // 1-5
  status        String   @default("active") // active, inactive, blacklisted
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  quotations     VendorQuotation[]
}

model VendorQuotation {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  itemId      String?
  itemName    String
  quantity    Float
  unitPrice   Float
  validTill   DateTime?
  status      String   @default("pending") // pending, accepted, rejected, expired
  notes       String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PurchaseRequisition {
  id          String   @id @default(cuid())
  prNumber    String   @unique
  title       String
  description String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  requestedById String
  requestedBy User     @relation("PRRequestor", fields: [requestedById], references: [id])
  approvedById String?
  approvedBy  User?    @relation("PRApprover", fields: [approvedById], references: [id])
  status      String   @default("draft") // draft, submitted, approved, rejected, cancelled, converted
  priority    String   @default("normal") // low, normal, high, urgent
  requiredBy  DateTime?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseRequisitionItem[]
}

model PurchaseRequisitionItem {
  id             String   @id @default(cuid())
  requisitionId  String
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemName       String
  description    String?
  quantity       Float
  unit           String
  estimatedPrice Float?
  notes          String?
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  createdById     String
  createdBy       User     @relation("POCreator", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?    @relation("POApprover", fields: [approvedById], references: [id])
  status          String   @default("draft") // draft, submitted, approved, partially_received, received, cancelled
  orderDate       DateTime @default(now())
  expectedDelivery DateTime?
  totalAmount     Float    @default(0)
  gstAmount       Float    @default(0)
  discount        Float    @default(0)
  netAmount       Float    @default(0)
  paymentStatus   String   @default("unpaid") // unpaid, partial, paid
  paymentMode     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  itemName    String
  description String?
  quantity    Float
  unit        String
  unitPrice   Float
  gstRate     Float    @default(0)
  totalPrice  Float
  receivedQty Float    @default(0)
  status      String   @default("pending") // pending, partially_received, received, returned
}

model GoodsReceivedNote {
  id              String   @id @default(cuid())
  grnNumber       String   @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  receivedById    String
  receivedBy      User     @relation("GRNReceiver", fields: [receivedById], references: [id])
  receivedDate    DateTime @default(now())
  invoiceNumber   String?
  invoiceDate     DateTime?
  invoiceAmount   Float?
  status          String   @default("pending_inspection") // pending_inspection, accepted, partially_accepted, rejected
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items GoodsReceivedNoteItem[]
}

model GoodsReceivedNoteItem {
  id           String   @id @default(cuid())
  grnId        String
  grn          GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId     String?
  itemName     String
  orderedQty   Float
  receivedQty  Float
  acceptedQty  Float
  rejectedQty  Float    @default(0)
  unitPrice    Float
  batchNumber  String?
  expiryDate   DateTime?
  notes        String?
}

model StockTransaction {
  id            String   @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  type          String   // purchase, issue, adjustment, transfer_in, transfer_out, return, opening, closing, damage, expiry
  quantity      Float    // positive for in, negative for out
  previousStock Float
  newStock      Float
  unitPrice     Float?
  reference     String?  // PO number, GRN number, issue slip number
  referenceId   String?  // ID of related PO/GRN/Issue
  batchNumber   String?
  expiryDate    DateTime?
  notes         String?
  performedById String?
  performedBy   User?    @relation("StockTransactionUser", fields: [performedById], references: [id])
  createdAt     DateTime @default(now())
}

model MenuPlan {
  id          String   @id @default(cuid())
  date        DateTime
  mealType    String   // breakfast, lunch, snacks, dinner
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  headCount   Int      @default(0)
  status      String   @default("planned") // planned, preparing, served, completed
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuPlanItem[]
}

model MenuPlanItem {
  id         String   @id @default(cuid())
  menuPlanId String
  menuPlan   MenuPlan @relation(fields: [menuPlanId], references: [id], onDelete: Cascade)
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  dishName   String
  servings   Int      @default(1)
  notes      String?
}

model Recipe {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("veg") // veg, non_veg, vegan
  mealType    String   @default("lunch") // breakfast, lunch, snacks, dinner
  baseServings Int     @default(100)
  instructions String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeItem[]
  menuItems   MenuPlanItem[]
}

model RecipeItem {
  id         String   @id @default(cuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  quantity   Float    // quantity for baseServings
  unit       String
  notes      String?
}

model KitchenIssue {
  id          String   @id @default(cuid())
  issueNumber String   @unique
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  quantity    Float
  unit        String
  issuedTo    String   // kitchen, staff name
  purpose     String?  // breakfast, lunch, dinner, snacks, special
  menuPlanId  String?
  menuDate    DateTime?
  issuedById  String
  issuedBy    User     @relation("KitchenIssuer", fields: [issuedById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MessAttendance {
  id          String   @id @default(cuid())
  date        DateTime
  mealType    String   // breakfast, lunch, snacks, dinner
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  present     Boolean  @default(false)
  guestCount  Int      @default(0)
  notes       String?
  markedById  String?
  markedBy    User?    @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConsumptionLog {
  id          String   @id @default(cuid())
  date        DateTime
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  mealType    String?  // breakfast, lunch, snacks, dinner
  issuedQty   Float    @default(0)
  consumedQty Float    @default(0)
  returnedQty Float    @default(0)
  wastageQty  Float    @default(0)
  unit        String
  costPerUnit Float    @default(0)
  totalCost   Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WasteRecord {
  id          String   @id @default(cuid())
  date        DateTime
  category    String   // food_waste, expired, damaged, spoilage, other
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  description String
  quantity    Float    @default(0)
  unit        String?
  estimatedCost Float  @default(0)
  disposalMethod String? // compost, trash, donation, recycling
  disposalDate DateTime?
  recordedById String?
  recordedBy  User?    @relation("WasteRecorder", fields: [recordedById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id              String   @id @default(cuid())
  name            String
  assetTag        String?
  category        String   // furniture, electrical, electronics, appliance, kitchen_equipment, other
  subCategory     String?  // bed, mattress, chair, table, fan, ac, tv, water_cooler, washing_machine, refrigerator, gas_stove
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])
  purchaseDate    DateTime?
  purchasePrice   Float?
  currentValue    Float?
  depreciationRate Float?
  vendor          String?
  warrantyExpiry  DateTime?
  status          String   @default("active") // active, under_maintenance, disposed, lost
  condition       String   @default("good") // excellent, good, fair, poor, broken
  assignedTo      String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LaundryItem {
  id              String   @id @default(cuid())
  name            String   // bedsheets, blankets, pillows, towels, curtains
  category        String   // bedding, bathroom, curtain, other
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])
  totalQuantity   Int      @default(0)
  issuedQuantity   Int      @default(0)
  inLaundry       Int      @default(0)
  damagedQuantity  Int      @default(0)
  condition       String   @default("good") // good, fair, poor
  lastWashDate    DateTime?
  nextWashDate    DateTime?
  replacementDate DateTime?
  status          String   @default("in_use") // in_use, in_laundry, stored, damaged, disposed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HousekeepingItem {
  id              String   @id @default(cuid())
  name            String   // phenyl, floor_cleaner, soap, detergent, mop, bucket, tissue_roll, garbage_bag
  category        String   // cleaning, hygiene, tool, other
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  unit            String   // l, kg, pcs, pack, roll
  currentStock    Float    @default(0)
  minStock        Float    @default(0)
  unitPrice       Float    @default(0)
  lastRestocked   DateTime?
  nextRestock     DateTime?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Role Permissions (RBAC Persistence) ───────────────────
model RolePermission {
  id          String   @id @default(cuid())
  role        String   @unique
  permissions String   // JSON string of permissions array
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─── User Permission Override (Per-User Micro RBAC) ──────────
// Allows super admin to override individual user's permissions
// beyond their role's default permissions
model UserPermissionOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission      String   // e.g., "tenants:create", "payments:delete"
  granted         Boolean  @default(true) // true = explicitly granted, false = explicitly denied
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, permission]) // One override per user per permission
}

// ─── Hostel Assignment (Multi-Tenancy) ─────────────────────
model HostelAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role       String   // owner, manager, staff, tenant - role within this specific hostel
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, propertyId]) // A user can only be assigned once per hostel
}
